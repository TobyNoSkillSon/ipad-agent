{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipad-agent.local/schemas/compatibility-v1.json",
  "title": "iPad Agent redacted compatibility summary v1",
  "type": "object",
  "required": ["$schema", "schema", "version", "generated_at", "source_evidence", "integrations", "redaction"],
  "properties": {
    "$schema": {"const": "schemas/compatibility-v1.json"},
    "schema": {"const": "ipad-agent.compatibility/v1"},
    "version": {"const": 1},
    "generated_at": {
      "type": "string", "format": "date-time", "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "source_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sha256"],
        "properties": {"sha256": {"$ref": "#/$defs/digest"}},
        "additionalProperties": false
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "physical_tested", "platform", "os_versions", "locales", "scenarios", "limitations"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "physical_tested": {"type": "boolean"},
          "platform": {"const": "iPadOS"},
          "os_versions": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][A-Za-z0-9.-]+)?$"}},
          "locales": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"}},
          "scenarios": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "mode", "status", "evidence_sha256", "metrics"],
              "properties": {
                "id": {"$ref": "#/$defs/id"},
                "mode": {"enum": ["fake", "physical", "discovery", "benchmark"]},
                "status": {"enum": ["pass", "fail"]},
                "evidence_sha256": {"$ref": "#/$defs/digest"},
                "metrics": {
                  "type": "object",
                  "propertyNames": {"enum": ["warmups", "runs", "minimum_seconds", "median_seconds", "p95_seconds", "maximum_seconds", "successful_runs", "uncertain_runs", "elapsed_seconds", "candidate_count", "repeatable_candidate_count"]},
                  "additionalProperties": {"type": "number", "minimum": 0}
                }
              },
              "additionalProperties": false
            }
          },
          "limitations": {"const": []}
        },
        "additionalProperties": false
      }
    },
    "redaction": {
      "const": {
        "raw_evidence_committed": false,
        "excluded": [
          "device identifiers", "hostnames", "user or team values", "tokens", "paths",
          "URLs", "UI source", "raw responses", "authorization actors and requests"
        ],
        "policy": "strict field allow-list plus SHA-256 evidence references only"
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
