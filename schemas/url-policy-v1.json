{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ipad-agent.local/schemas/url-policy-v1.json",
  "title": "iPad Agent integration URL policy v1",
  "type": "object",
  "required": ["$schema", "schema", "version", "integration_id", "actions"],
  "properties": {
    "$schema": {"const": "../../schemas/url-policy-v1.json"},
    "schema": {"const": "ipad-agent.url-policy/v1"},
    "version": {"const": 1},
    "integration_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "actions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*$"}
      }
    }
  },
  "additionalProperties": false
}
